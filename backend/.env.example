# Application
APP_NAME=Uplift.ai API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security — change SECRET_KEY in production
SECRET_KEY=dev-change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=8

# Database (SQLite for local; swap to Postgres via docker-compose)
DATABASE_URL=sqlite+aiosqlite:///./uplift.db

# Redis (optional locally; used for rate limiting when available)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["*"]
